---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Tawanda Masvikeni — indie app builder, writer, occasional chaos agent." } = Astro.props;
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/books', label: 'Books' },
  { href: '/games', label: 'Play' },
  { href: '/coaching', label: 'Relational' },
  { href: '/boutique', label: 'Boutique' },
  { href: '/blog', label: 'Blog' },
];
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta name="description" content={description} />
  <title>{title === 'Home' ? 'Tawanda Masvikeni: Personal Website' : `${title} — Tawanda Masvikeni`}</title>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..300,0..1&display=block" rel="stylesheet" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#f9f9f9" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <link rel="apple-touch-icon" href="/icon-512.png" />
  <ViewTransitions />
  <script is:inline>
    // Service Worker Registration for PWA
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').then(reg => {
          console.log('SW registered');
        }).catch(err => console.log('SW error', err));
      });
    }
  </script>
  <style>
    .noise-bg {
      position: relative;
    }
    .noise-bg::after {
      content: "";
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.04;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }
  </style>
</head>
<body class="bg-surface text-on-background font-body-md selection:bg-primary selection:text-white noise-bg">
  <!-- Navigation -->
  <nav id="boutique-nav" class="fixed top-0 left-0 right-0 z-50 h-24 transition-all duration-500">
    <div class="flex justify-between items-center w-full px-margin-mobile md:px-gutter max-w-container-max mx-auto h-full">
      <!-- Wordmark -->
      <a href="/" id="nav-wordmark" class="font-display text-[32px] font-extrabold uppercase tracking-tight transition-all duration-500 text-on-background flex-shrink-0 z-10">
        T.
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden xl:flex items-center gap-3 flex-nowrap justify-center">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="hover:opacity-50 transition-opacity font-label-md text-[0.7rem] uppercase tracking-wider text-on-background flex-shrink-0"
          >
            {link.label.toUpperCase()}
          </a>
        ))}
      </div>

      <!-- Desktop CTA -->
      <a href="mailto:pjmasvikeni@gmail.com" id="nav-cta" class="border-b border-on-background pb-1 font-label-md text-[0.7rem] hover:opacity-50 transition-all duration-500 uppercase opacity-0 pointer-events-none text-on-background hidden xl:block flex-shrink-0">
        Pursue You
      </a>

      <!-- Mobile Menu Button -->
      <button id="menu-toggle" class="xl:hidden flex items-center gap-2 font-label-md text-label-sm uppercase text-on-background flex-shrink-0 z-10">
        <span class="material-symbols-outlined">menu</span>
        Menu
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-surface flex-col items-center justify-center gap-8 hidden">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="font-display text-[32px] font-bold uppercase tracking-tight text-on-background hover:text-primary transition-colors"
      >
        {link.label}
      </a>
    ))}
  </div>

  <main class="pt-32">
    <slot />
  </main>

  <footer class="py-12 px-margin-mobile md:px-gutter max-w-container-max mx-auto border-t border-outline-variant">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest">tawanda.space</p>
      <p class="font-body-md text-body-md text-on-surface-variant">© {new Date().getFullYear()} Tawanda Masvikeni</p>
    </div>
  </footer>

  <script is:inline>
    // Scroll Behavior for Navigation
    function initScrollNav() {
        const nav = document.getElementById('boutique-nav');
        const wordmark = document.getElementById('nav-wordmark');
        const ctaButton = document.getElementById('nav-cta');
        const menuToggle = document.getElementById('menu-toggle');
        const heroSection = document.querySelector('main');

      if (!nav || !wordmark || !ctaButton || !menuToggle || !heroSection) return;

      function handleScroll() {
        const scrollY = window.scrollY;
        const heroHeight = heroSection.offsetHeight;
        const scrolled = scrollY > 40;

        // Nav background: frosted on scroll, transparent at top
        if (scrolled) {
          nav.style.backgroundColor = 'rgba(250, 246, 244, 0.88)';
          nav.style.backdropFilter = 'blur(16px)';
          nav.style.WebkitBackdropFilter = 'blur(16px)';
          nav.style.borderBottom = '0.5px solid rgba(0,0,0,0.03)';
          nav.style.height = '3.5rem';
        } else {
          nav.style.backgroundColor = 'transparent';
          nav.style.backdropFilter = 'none';
          nav.style.WebkitBackdropFilter = 'none';
          nav.style.borderBottom = 'none';
          nav.style.height = '6rem';
        }

        // T wordmark and menu button: fade out while scrolling
        if (scrollY > 30) {
          wordmark.classList.add('opacity-0', 'pointer-events-none');
          wordmark.classList.remove('opacity-100');
          menuToggle.classList.add('opacity-0', 'pointer-events-none');
          menuToggle.classList.remove('opacity-100');
        } else {
          wordmark.classList.add('opacity-100');
          wordmark.classList.remove('opacity-0', 'pointer-events-none');
          menuToggle.classList.add('opacity-100');
          menuToggle.classList.remove('opacity-0', 'pointer-events-none');
        }

        // Pursue You CTA: appears after hero
        if (scrollY > heroHeight - 100) {
          ctaButton.classList.add('opacity-100');
          ctaButton.classList.remove('opacity-0', 'pointer-events-none');
        } else {
          ctaButton.classList.add('opacity-0', 'pointer-events-none');
          ctaButton.classList.remove('opacity-100');
        }
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    // Mobile menu toggle
    function initMobileMenu() {
      const menuToggle = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinks = mobileMenu?.querySelectorAll('a');

      if (!menuToggle || !mobileMenu) return;

      menuToggle.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        mobileMenu.classList.toggle('flex');
      });

      mobileLinks?.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('flex');
        });
      });
    }

    document.addEventListener('astro:page-load', () => {
      initScrollNav();
      initMobileMenu();
    });

    // Initialize immediately on first load
    initScrollNav();
    initMobileMenu();
  </script>
</body>
</html>
