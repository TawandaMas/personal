---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Tawanda Masvikeni — indie app builder, writer, occasional chaos agent." } = Astro.props;
const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => path.endsWith('/') && path.length > 1 ? path.slice(0, -1) : path;
const isNavLinkActive = (href: string) => {
  const current = normalizePath(currentPath);
  const target = normalizePath(href);
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
};
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/books', label: 'Books' },
  { href: '/games', label: 'Play' },
  { href: '/coaching', label: 'Relational' },
  { href: '/boutique', label: 'Boutique' },
  { href: '/blog', label: 'Blog' },
];
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta name="description" content={description} />
  <title>{title === 'Home' ? 'Tawanda Masvikeni: Personal Website' : `${title} — Tawanda Masvikeni`}</title>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=Yellowtail&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..300,0..1&display=block" rel="stylesheet" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#f9f9f9" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <link rel="apple-touch-icon" href="/icon-512.png" />
  <ViewTransitions />
  <script is:inline>
    // Service Worker Registration for PWA
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').then(reg => {
          console.log('SW registered');
        }).catch(err => console.log('SW error', err));
      });
    }
  </script>
  <style>
    .noise-bg {
      position: relative;
    }
    .noise-bg::after {
      content: "";
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.04;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }
  </style>
</head>
<body class="bg-surface text-on-background font-body-md selection:bg-primary selection:text-white noise-bg">
  <!-- Navigation -->
  <nav id="site-nav" transition:persist="site-nav" class="fixed top-0 left-0 right-0 z-50 h-20 xl:h-24 transition-[background-color,backdrop-filter,border-color] duration-300 ease-out-soft">
    <div class="flex justify-center items-center w-full px-margin-mobile md:px-gutter max-w-container-max mx-auto h-full">
      <!-- Desktop Nav Links -->
      <div class="hidden xl:flex items-center gap-3 flex-nowrap justify-center relative" id="desktop-nav">
        {navLinks.map((link, index) => (
          <a
            href={link.href}
            data-nav-index={index}
            aria-current={isNavLinkActive(link.href) ? 'page' : undefined}
            class:list={[
              'nav-link-elegant font-label-md text-[0.7rem] uppercase tracking-wider flex-shrink-0 pb-0.5 relative z-10',
              isNavLinkActive(link.href) ? 'text-on-background' : 'text-on-background hover:opacity-60',
            ]}
          >
            {link.label.toUpperCase()}
          </a>
        ))}
        <!-- Gliding Active Indicator -->
        <div
          id="gliding-indicator"
          class="absolute bottom-0 left-0 h-px bg-on-background transition-[transform,width] duration-300 ease-out-soft"
          style="pointer-events: none;"
        ></div>
      </div>



      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        class="xl:hidden flex items-center justify-center gap-2 min-h-11 min-w-11 -mr-2 rounded-2xl border border-black/8 bg-white/55 px-3 text-on-background shadow-[0_10px_30px_-16px_rgba(0,0,0,0.28)] backdrop-blur-md supports-[backdrop-filter]:bg-white/45 font-label-md text-label-sm uppercase flex-shrink-0 cursor-pointer touch-manipulation select-none transition-all duration-300 ease-out-soft"
      >
        <span id="menu-toggle-icon" class="material-symbols-outlined text-[22px]" aria-hidden="true">menu</span>
        <span id="menu-toggle-label">Menu</span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    transition:persist="mobile-menu"
    class="fixed inset-0 z-[60] bg-surface flex flex-col overscroll-contain"
    aria-hidden="true"
    inert
  >
    <div class="flex justify-end items-center px-margin-mobile h-20 flex-shrink-0 border-b border-outline-variant/40">
      <button
        type="button"
        id="menu-close"
        aria-label="Close menu"
        class="flex items-center justify-center min-h-11 min-w-11 -mr-2 rounded-2xl border border-black/8 bg-white/55 text-on-background shadow-[0_10px_30px_-16px_rgba(0,0,0,0.28)] backdrop-blur-md supports-[backdrop-filter]:bg-white/45 touch-manipulation select-none"
      >
        <span class="material-symbols-outlined text-[28px]" aria-hidden="true">close</span>
      </button>
    </div>

    <nav class="flex flex-col items-start flex-1 gap-1 px-margin-mobile py-8 overflow-y-auto">
      {navLinks.map(link => (
        <a
          href={link.href}
          aria-current={isNavLinkActive(link.href) ? 'page' : undefined}
          class:list={[
            'w-full py-3 font-display text-[28px] font-bold uppercase tracking-tight transition-colors touch-manipulation',
            isNavLinkActive(link.href)
              ? 'text-primary'
              : 'text-on-background hover:text-primary active:text-primary',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <main class="pt-32">
    <slot />
  </main>

  <footer transition:persist="footer-bar" class="py-12 px-margin-mobile md:px-gutter max-w-container-max mx-auto border-t border-outline-variant" data-reveal="fade">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest">tawanda.space</p>
      <p class="font-body-md text-body-md text-on-surface-variant">© {new Date().getFullYear()} Tawanda Masvikeni</p>
    </div>
  </footer>

  <script is:inline>
    (function() {
      function normalizePath(path) {
        return path.endsWith('/') && path.length > 1 ? path.slice(0, -1) : path;
      }

      var XL_BREAKPOINT = 1280;
      var shouldCloseMenuAfterNavigation = false;

      function isDesktop() {
        return window.matchMedia('(min-width: ' + XL_BREAKPOINT + 'px)').matches;
      }

      function isNavLinkActiveClient(href) {
        var current = normalizePath(window.location.pathname);
        var target = normalizePath(href || '');
        if (target === '/') return current === '/';
        return current === target || current.indexOf(target + '/') === 0;
      }

      function getNavElements() {
        return {
          nav: document.getElementById('site-nav'),
          menuToggle: document.getElementById('menu-toggle'),
          menuClose: document.getElementById('menu-close'),
          mobileMenu: document.getElementById('mobile-menu'),
          menuToggleIcon: document.getElementById('menu-toggle-icon'),
          menuToggleLabel: document.getElementById('menu-toggle-label'),
        };
      }

      function isMenuOpen() {
        var mobileMenu = document.getElementById('mobile-menu');
        return mobileMenu && mobileMenu.classList.contains('is-open');
      }

      function setMenuOpen(open) {
        var els = getNavElements();
        if (!els.mobileMenu || !els.menuToggle) return;

        if (open) {
          shouldCloseMenuAfterNavigation = false;
          els.mobileMenu.classList.remove('is-routing');
          els.mobileMenu.classList.add('is-open');
          els.mobileMenu.setAttribute('aria-hidden', 'false');
          els.mobileMenu.removeAttribute('inert');
          els.menuToggle.setAttribute('aria-expanded', 'true');
          els.menuToggle.setAttribute('aria-label', 'Close menu');
          if (els.menuToggleIcon) els.menuToggleIcon.textContent = 'close';
          if (els.menuToggleLabel) els.menuToggleLabel.textContent = 'Close';
          document.body.style.overflow = 'hidden';
        } else {
          els.mobileMenu.classList.remove('is-open');
          els.mobileMenu.classList.remove('is-routing');
          els.mobileMenu.setAttribute('aria-hidden', 'true');
          els.mobileMenu.setAttribute('inert', '');
          els.menuToggle.setAttribute('aria-expanded', 'false');
          els.menuToggle.setAttribute('aria-label', 'Open menu');
          if (els.menuToggleIcon) els.menuToggleIcon.textContent = 'menu';
          if (els.menuToggleLabel) els.menuToggleLabel.textContent = 'Menu';
          document.body.style.overflow = '';
        }
      }

      function closeMenu() {
        shouldCloseMenuAfterNavigation = false;
        if (isMenuOpen()) setMenuOpen(false);
      }

      function toggleMenu() {
        setMenuOpen(!isMenuOpen());
      }

      function syncActiveNavLinks() {
        var allNavLinks = document.querySelectorAll('#site-nav a[href]');
        allNavLinks.forEach(function(link) {
          var href = link.getAttribute('href');
          if (isNavLinkActiveClient(href)) {
            link.setAttribute('aria-current', 'page');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      }

      document.addEventListener('click', function(e) {
        var els = getNavElements();
        if (!els.menuToggle || !els.mobileMenu) return;

        if (els.menuToggle.contains(e.target)) {
          e.preventDefault();
          toggleMenu();
          return;
        }

        if (els.menuClose && els.menuClose.contains(e.target)) {
          e.preventDefault();
          closeMenu();
          els.menuToggle.focus();
          return;
        }

        var clickedDesktopLink = e.target.closest('#desktop-nav a');
        if (clickedDesktopLink) {
          positionGlidingIndicatorToLink(clickedDesktopLink);
          return;
        }

        var clickedLink = e.target.closest('#mobile-menu a');
        if (clickedLink) {
          shouldCloseMenuAfterNavigation = true;
          els.mobileMenu.classList.add('is-routing');
          document.body.style.overflow = 'hidden';
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key !== 'Escape' || !isMenuOpen()) return;
        var menuToggle = document.getElementById('menu-toggle');
        closeMenu();
        if (menuToggle) menuToggle.focus();
      });

      function updateScrollNav() {
        var els = getNavElements();
        var heroSection = document.querySelector('main');
        if (!els.nav || !heroSection) return;

        var scrollY = window.scrollY;
        var heroHeight = heroSection.offsetHeight;
        var scrolled = scrollY > 16;
        var desktop = isDesktop();

        if (desktop && scrolled) {
          els.nav.style.backgroundColor = 'rgba(249, 249, 249, 0.92)';
          els.nav.style.backdropFilter = 'blur(16px)';
          els.nav.style.webkitBackdropFilter = 'blur(16px)';
          els.nav.style.borderBottom = '0.5px solid rgba(0, 0, 0, 0.06)';
        } else {
          els.nav.style.backgroundColor = 'transparent';
          els.nav.style.backdropFilter = 'none';
          els.nav.style.webkitBackdropFilter = 'none';
          els.nav.style.borderBottom = 'none';
        }

        if (!desktop) {
          if (els.menuToggle) {
            els.menuToggle.classList.remove('opacity-0', 'pointer-events-none');
          }
        }


      }

      window.addEventListener('scroll', updateScrollNav, { passive: true });

      document.addEventListener('astro:after-swap', function() {
        syncActiveNavLinks();
        requestAnimationFrame(function() {
          if (shouldCloseMenuAfterNavigation) closeMenu();
          shouldCloseMenuAfterNavigation = false;
          updateScrollNav();
          updateGlidingIndicator();
        });
      });

      function positionGlidingIndicatorToLink(link) {
        if (!isDesktop()) return;
        var desktopNav = document.getElementById('desktop-nav');
        var indicator = document.getElementById('gliding-indicator');
        if (!desktopNav || !indicator || !link) return;

        var rect = link.getBoundingClientRect();
        var navRect = desktopNav.getBoundingClientRect();
        indicator.style.left = '0px';
        indicator.style.width = rect.width + 'px';
        indicator.style.transform = 'translateX(' + (rect.left - navRect.left) + 'px)';
      }

      function updateGlidingIndicator() {
        if (!isDesktop()) return;
        var desktopNav = document.getElementById('desktop-nav');
        var indicator = document.getElementById('gliding-indicator');
        if (!desktopNav || !indicator) return;

        var links = desktopNav.querySelectorAll('a[href]');
        var activeLink = null;
        links.forEach(function(link) {
          if (activeLink) return;
          var href = link.getAttribute('href');
          if (isNavLinkActiveClient(href)) activeLink = link;
        });
        if (!activeLink) return;
        positionGlidingIndicatorToLink(activeLink);
      }

      function onPageReady() {
        syncActiveNavLinks();
        updateScrollNav();
        updateGlidingIndicator();
        if (!isDesktop()) {
          var els = getNavElements();
          if (els.menuToggle) {
            els.menuToggle.classList.remove('opacity-0', 'pointer-events-none');
          }
        }
      }

      onPageReady();
      document.addEventListener('astro:page-load', onPageReady);
      window.addEventListener('resize', updateGlidingIndicator);
    })();
  </script>
  <script>
    import '../scripts/motion.js';
  </script>
</body>
</html>
