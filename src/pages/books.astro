---
import Base from '../layouts/Base.astro';

import { getCollection } from 'astro:content';

const bookEntries = await getCollection('books');
const books = bookEntries
  .map(b => ({ ...b.data }))
  .sort((a, b) => (a.order || 99) - (b.order || 99));

const reading = books.filter(b => b.status === 'reading');
const read = books.filter(b => b.status === 'read');
const queue = books.filter(b => b.status === 'queue');
---

<Base title="Books">
  <div class="px-margin-mobile md:px-gutter max-w-container-max mx-auto py-16 md:py-24">
    <div class="mb-12">
      <h1 class="font-display text-[48px] md:text-[64px] uppercase leading-none mb-4" data-reveal>The Library</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant italic" data-reveal data-reveal-delay="0.08">A digital card catalog of things I've consumed and contemplated.</p>
    </div>

    <div class="space-y-16 pb-16">
      {reading.length > 0 && (
        <div class="drawer-section" data-reveal data-reveal-delay="0.12">
          <div class="flex items-center gap-4 mb-8">
            <div class="w-8 h-px bg-secondary opacity-30"></div>
            <h2 class="font-label-sm uppercase tracking-[0.15em] text-secondary">In Progress</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-stagger>
            {reading.map((book, i) => (
              <div class="bg-surface border border-outline-variant rounded-lg p-6 min-h-[220px] flex flex-col card-elegant hover:border-secondary">
                <div class="inline-block font-label-sm text-[0.65rem] font-bold px-2 py-1 border border-outline-variant rounded mb-6 bg-secondary text-white">Reading</div>
                <div class="flex-1">
                  <h3 class="font-display text-xl uppercase tracking-tight mb-2 text-on-background">{book.title}</h3>
                  <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.05em] mb-4">{book.author} — {book.year}</p>
                  {book.rating > 0 && (
                    <div class="flex gap-1 mb-4 text-outline-variant text-[0.85rem]" aria-label={`Rating: ${book.rating} out of 5 stars`}>
                      {[...Array(5)].map((_, i) => {
                        const full = i < Math.floor(book.rating);
                        const half = !full && i < book.rating;
                        return (
                          <span class:list={['star', { 'text-secondary': full || half }]}>★</span>
                        );
                      })}
                    </div>
                  )}
                  <div class="h-px bg-outline-variant opacity-60 mb-4"></div>
                  {book.note && <p class="font-body-md text-body-md text-on-surface-variant italic leading-relaxed">{book.note}</p>}
                </div>
                <div class="pt-6 flex justify-end">
                  <span class="font-label-sm text-[0.6rem] font-bold uppercase tracking-[0.05em] px-2 py-1 border border-outline-variant rounded bg-surface text-on-background">{book.genre}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {read.length > 0 && (
        <div class="drawer-section" data-reveal>
          <div class="flex items-center gap-4 mb-8">
            <div class="w-8 h-px bg-secondary opacity-30"></div>
            <h2 class="font-label-sm uppercase tracking-[0.15em] text-secondary">Archive</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-stagger>
            {read.map((book, i) => (
              <div class="bg-surface border border-outline-variant rounded-lg p-6 min-h-[220px] flex flex-col card-elegant hover:border-secondary">
                <div class="inline-block font-label-sm text-[0.65rem] font-bold px-2 py-1 border border-outline-variant rounded mb-6 bg-surface text-on-background">Finished</div>
                <div class="flex-1">
                  <h3 class="font-display text-xl uppercase tracking-tight mb-2 text-on-background">{book.title}</h3>
                  <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.05em] mb-4">{book.author} — {book.year}</p>
                  {book.rating > 0 && (
                    <div class="flex gap-1 mb-4 text-outline-variant text-[0.85rem]" aria-label={`Rating: ${book.rating} out of 5 stars`}>
                      {[...Array(5)].map((_, i) => {
                        const full = i < Math.floor(book.rating);
                        const half = !full && i < book.rating;
                        return (
                          <span class:list={['star', { 'text-secondary': full || half }]}>★</span>
                        );
                      })}
                    </div>
                  )}
                  <div class="h-px bg-outline-variant opacity-60 mb-4"></div>
                  {book.note && <p class="font-body-md text-body-md text-on-surface-variant italic leading-relaxed">{book.note}</p>}
                </div>
                <div class="pt-6 flex justify-end">
                  <span class="font-label-sm text-[0.6rem] font-bold uppercase tracking-[0.05em] px-2 py-1 border border-outline-variant rounded bg-surface text-on-background">{book.genre}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {queue.length > 0 && (
        <div class="drawer-section" data-reveal>
          <div class="flex items-center gap-4 mb-8">
            <div class="w-8 h-px bg-secondary opacity-30"></div>
            <h2 class="font-label-sm uppercase tracking-[0.15em] text-secondary">Wishlist</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-stagger>
            {queue.map((book, i) => (
              <div class="bg-surface-container-low border border-outline-variant rounded-lg p-6 min-h-[220px] flex flex-col card-elegant hover:border-secondary">
                <div class="inline-block font-label-sm text-[0.65rem] font-bold px-2 py-1 border border-outline-variant rounded mb-6 bg-surface-container-low text-on-surface-variant">Queue</div>
                <div class="flex-1">
                  <h3 class="font-display text-xl uppercase tracking-tight mb-2 text-on-background">{book.title}</h3>
                  <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.05em] mb-4">{book.author} — {book.year}</p>
                  {book.rating > 0 && (
                    <div class="flex gap-1 mb-4 text-outline-variant text-[0.85rem]" aria-label={`Rating: ${book.rating} out of 5 stars`}>
                      {[...Array(5)].map((_, i) => {
                        const full = i < Math.floor(book.rating);
                        const half = !full && i < book.rating;
                        return (
                          <span class:list={['star', { 'text-secondary': full || half }]}>★</span>
                        );
                      })}
                    </div>
                  )}
                  <div class="h-px bg-outline-variant opacity-60 mb-4"></div>
                  {book.note && <p class="font-body-md text-body-md text-on-surface-variant italic leading-relaxed">{book.note}</p>}
                </div>
                <div class="pt-6 flex justify-end">
                  <span class="font-label-sm text-[0.6rem] font-bold uppercase tracking-[0.05em] px-2 py-1 border border-outline-variant rounded bg-surface-container-low text-on-background">{book.genre}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Base>
