---
import Base from '../layouts/Base.astro';
---

<Base title="Home">
  <article class="home-copy prose px-margin-mobile md:px-gutter max-w-container-max mx-auto py-16 md:py-24">

    <figure class="corner-me" data-reveal="scale" data-reveal-delay="0.1">
      <img src="/me.png" alt="Tawanda" />
      <figcaption>Me.</figcaption>
    </figure>

    <p class="font-body-lg text-body-lg text-on-surface-variant mb-6" data-reveal data-reveal-delay="0.15">
      I am an author and storyteller.
    </p>



    <p class="font-body-lg text-body-lg text-on-surface-variant mb-6" data-reveal data-reveal-delay="0.36">
      If you would like <a href="/books" class="text-primary link-refined">book recommendations</a>, here are dozens I've greatly enjoyed.
    </p>

    <p class="font-body-lg text-body-lg text-on-surface-variant" data-reveal data-reveal-delay="0.43">
      You may email me at <a href="mailto:tawanda@accompla.app" class="text-primary link-refined">tawanda@accompla.app</a>.
    </p>

  </article>
</Base>


<style>
  .home-copy {
    overflow: hidden;
  }

  .corner-me {
    float: right;
    width: clamp(120px, 25vw, 180px);
    margin-left: 2rem;
    margin-bottom: 1rem;
    padding: 0.5rem;
    background: #f9f9f9;
    border: 1px solid #cfc4c5;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    transform: rotate(2deg);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .corner-me:hover {
    transform: rotate(-1deg) scale(1.02);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
  }

  .corner-me img {
    width: 100%;
    display: block;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid #cfc4c5;
    border-radius: 8px;
  }

  .corner-me figcaption {
    font-family: Hanken Grotesk, system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: #1a1c1c;
    text-align: center;
    margin-top: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
