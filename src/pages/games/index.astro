---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const gameFiles = await getCollection('games');
const games = gameFiles
  .map(g => ({ slug: g.slug, ...g.data }))
  .sort((a, b) => (a.order || 99) - (b.order || 99));
---

<Base title="Games">
  <div class="px-margin-mobile md:px-gutter max-w-container-max mx-auto py-16 md:py-24">
    <div class="mb-12">
      <h1 class="font-display text-[48px] md:text-[64px] uppercase leading-none mb-4" data-reveal>Games</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant italic" data-reveal data-reveal-delay="0.08">Amuse yourself a little.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-6 pt-4" data-reveal-stagger data-reveal-delay="0.15">
      {games.map(game => (
        <a href={`/games/${game.slug}`} class="bg-surface p-8 text-inherit flex flex-col gap-2 border border-outline-variant shadow-[4px_4px_0_var(--tw-border-color)] hover:translate-x-[-4px] hover:-translate-y-1 hover:shadow-[8px_8px_0_var(--tw-secondary)] hover:border-on-background relative overflow-hidden transition-all duration-600 ease-expo-out">
          <div class="inline-block w-fit px-2 py-1 bg-surface-container border border-outline-variant font-label-sm text-label-sm uppercase text-on-background mb-2">
            {game.tag}
          </div>
          <h2 class="font-display text-[1.75rem] uppercase tracking-[-0.02em] text-on-background leading-tight">
            {game.title}
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant flex-1 mt-2 leading-snug">
            {game.description}
          </p>
          <div class="font-label-md text-label-md uppercase text-on-background mt-6 flex items-center gap-2 hover:text-secondary transition-colors">
            Play →
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
