  <script is:inline>
    // Reveal on scroll observer
    const observerOptions = { threshold: 0.15 };
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
            }
        });
    }, observerOptions);

    document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));

    // Artisan Carousel Logic
    function initCarousel() {
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('.carousel-dot');
        let currentSlide = 1; // Start on index 1 since active class is preset on second slide in HTML

        function nextSlide() {
            if (slides.length === 0) return;
            slides[currentSlide].classList.remove('active');
            dots[currentSlide].classList.add('opacity-20');
            dots[currentSlide].classList.remove('opacity-100');
            
            currentSlide = (currentSlide + 1) % slides.length;
            
            slides[currentSlide].classList.add('active');
            dots[currentSlide].classList.add('opacity-100');
            dots[currentSlide].classList.remove('opacity-20');
        }

        setInterval(nextSlide, 4500);
    }

    initCarousel();

    // Scroll Behavior for Navigation
    function initScrollNav() {
        const wordmark = document.getElementById('nav-wordmark');
        const ctaButton = document.getElementById('nav-cta');
        const heroSection = document.querySelector('section');

        if (!wordmark || !ctaButton || !heroSection) return;

        function handleScroll() {
            const scrollY = window.scrollY;
            const heroHeight = heroSection.offsetHeight;

            // T disappears while scrolling down (when scrollY > 30)
            if (scrollY > 30) {
                wordmark.classList.add('opacity-0', 'pointer-events-none');
                wordmark.classList.remove('opacity-100');
            } else {
                wordmark.classList.add('opacity-100');
                wordmark.classList.remove('opacity-0', 'pointer-events-none');
            }

            // Pursue You CTA appears only after scrolling past the hero section
            if (scrollY > heroHeight - 100) {
                ctaButton.classList.add('opacity-100');
                ctaButton.classList.remove('opacity-0', 'pointer-events-none');
            } else {
                ctaButton.classList.add('opacity-0', 'pointer-events-none');
                ctaButton.classList.remove('opacity-100');
            }
        }

        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll(); // Trigger initially in case page is already scrolled
    }

    initScrollNav();
  </script>
