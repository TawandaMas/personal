---
import Base from '../layouts/Base.astro';

import { getCollection } from 'astro:content';

const projectEntries = await getCollection('projects');
const projects = projectEntries
  .map(p => ({ ...p.data }))
  .sort((a, b) => (a.order || 99) - (b.order || 99));
---

<Base title="Projects">
  <div class="px-margin-mobile md:px-gutter max-w-container-max mx-auto py-16 md:py-24">
    <div class="mb-12">
      <h1 class="font-display text-[48px] md:text-[64px] uppercase leading-none mb-4" data-reveal>Projects</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant italic" data-reveal data-reveal-delay="0.08">Things I've shipped, or am shipping.</p>
    </div>

    <div class="flex flex-col gap-0" data-reveal-stagger data-reveal-delay="0.15">
      {projectEntries.map(project => (
        <div class="flex items-start gap-6 py-10 border-b border-outline-variant hover-lift-subtle group">
          {project.data.logo && (
            <div class="w-16 h-16 flex items-center justify-center bg-surface-container-low border border-outline-variant rounded-lg overflow-hidden flex-shrink-0 mt-0.5">
              <img src={project.data.logo} alt="" class="w-[60%] h-[60%] object-contain" />
            </div>
          )}
          <div class="flex-1">
            <div class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.08em] mb-1">{project.data.tag} · {project.data.year}</div>
            <h2 class="mb-2">
              <a href={`/projects/${project.slug}`} class="font-body-lg text-body-lg italic text-on-background hover:text-secondary transition-colors duration-600 ease-expo-out link-refined">
                {project.data.title}
              </a>
            </h2>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed max-w-[440px] mt-2">{project.data.description}</p>
          </div>
          <div class="flex flex-col items-end gap-1 flex-shrink-0 pt-1 ml-auto">
            <span class:list={['w-2 h-2 rounded-full', project.data.status === 'Live' ? 'bg-green-600 shadow-[0_0_5px_rgba(90,138,94,0.4)]' : 'bg-outline']}></span>
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.06em] mb-2">{project.data.status}</span>
            <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="text-on-surface-variant hover:text-secondary transition-colors" title="Visit Site">
              <span class="text-base transition-transform hover:translate-x-0.5 hover:-translate-y-0.5">↗</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Base>
