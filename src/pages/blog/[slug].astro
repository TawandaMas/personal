---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => ({
    params: { slug: entry.data.customSlug || entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={entry.data.title} description={entry.data.excerpt || entry.data.title}>
  <article class="px-margin-mobile md:px-gutter max-w-container-max mx-auto py-16 md:py-24 pb-24">

    {entry.data.heroImage && (
      <div class="w-full aspect-[16/7] overflow-hidden mb-12 border-b border-outline-variant">
        <img src={entry.data.heroImage} alt={entry.data.title} class="w-full h-full object-cover block" />
      </div>
    )}

    <header class="mb-12 pb-10 border-b border-outline-variant">
      <a href="/blog" class="inline-block mb-8 font-label-sm text-label-sm text-on-surface-variant hover:text-secondary transition-colors uppercase tracking-[0.06em]">← All posts</a>

      <div class="flex items-center gap-4 flex-wrap mb-5">
        <time datetime={entry.data.date.toISOString()} class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.08em]">{formatDate(entry.data.date)}</time>
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex gap-2 flex-wrap">
            {entry.data.tags.map(tag => <span class="font-label-sm text-label-sm text-secondary bg-surface-container border border-outline-variant rounded px-2 py-0.5 uppercase tracking-[0.06em]">{tag}</span>)}
          </div>
        )}
      </div>

      <h1 class="font-yellowtail text-on-background text-[clamp(2rem,5vw,3.25rem)] leading-tight mb-4 tracking-[-0.01em]">{entry.data.title}</h1>

      {entry.data.excerpt && (
        <p class="font-yellowtail text-on-surface-variant text-[clamp(1.2rem,2vw,1.5rem)] leading-relaxed mt-2">{entry.data.excerpt}</p>
      )}
    </header>

    <div class="font-body-lg text-body-lg text-on-background leading-relaxed">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-outline-variant">
      <a href="/blog" class="inline-block font-label-sm text-label-sm text-on-surface-variant hover:text-secondary transition-colors uppercase tracking-[0.06em]">← Back to Blog</a>
    </footer>

  </article>
</Base>
