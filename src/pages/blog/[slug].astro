---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => ({
    params: { slug: entry.data.customSlug || entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={entry.data.title} description={entry.data.excerpt || entry.data.title}>

  <article class="post-page">

    {entry.data.heroImage && (
      <div class="hero-image">
        <img src={entry.data.heroImage} alt={entry.data.title} />
      </div>
    )}

    <header class="post-header">
      <a href="/blog" class="back-link">← All posts</a>

      <div class="post-meta">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="tags">
            {entry.data.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>

      <h1 class="post-title">{entry.data.title}</h1>

      {entry.data.excerpt && (
        <p class="post-excerpt">{entry.data.excerpt}</p>
      )}
    </header>

    <div class="post-body prose">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back-link">← Back to Blog</a>
    </footer>

  </article>

</Base>

<style>
  .post-page {
    max-width: 720px;
    margin: 0 auto;
    padding-bottom: 6rem;
  }

  .hero-image {
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(-1 * var(--pad));
    aspect-ratio: 16 / 7;
    overflow: hidden;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-light);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--accent); }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .post-meta time {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-light);
  }

  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .tag {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    background: var(--accent-light);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 1rem;
  }

  .post-excerpt {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--ink-mid);
    font-style: italic;
    margin-top: 0.5rem;
  }

  .post-body {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--ink);
  }

  .post-body :global(p) { margin-bottom: 1.75rem; }

  .post-body :global(h2) {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 700;
    font-style: normal;
    color: var(--ink);
    margin: 3rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .post-body :global(h3) {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    font-style: normal;
    color: var(--ink);
    margin: 2rem 0 0.75rem;
  }

  .post-body :global(blockquote) {
    margin: 2.5rem 0;
    padding: 0.25rem 0 0.25rem 1.75rem;
    border-left: 3px solid var(--accent);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--ink-mid);
  }

  .post-body :global(blockquote p) { margin-bottom: 0; }

  .post-body :global(img) {
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--rule);
    margin: 2rem 0;
    display: block;
  }

  .post-body :global(figure) { margin: 2rem 0; }

  .post-body :global(figcaption) {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-light);
    text-align: center;
    margin-top: 0.5rem;
    font-style: normal;
  }

  .post-body :global(code) {
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
    background: var(--paper-dark);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.1em 0.35em;
    color: var(--ink);
  }

  .post-body :global(pre) {
    background: var(--paper-dark);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 2rem 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .post-body :global(pre code) { background: none; border: none; padding: 0; font-size: inherit; }

  .post-body :global(a) {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    font-weight: 600;
    transition: color 0.2s, border-color 0.2s;
  }

  .post-body :global(a:hover) { color: var(--accent); }

  .post-body :global(ul),
  .post-body :global(ol) { padding-left: 1.5rem; margin-bottom: 1.75rem; }

  .post-body :global(li) { margin-bottom: 0.5rem; }

  .post-body :global(hr) { border: none; border-top: 1px solid var(--rule); margin: 3rem 0; }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
</style>