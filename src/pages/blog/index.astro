---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const [featured, ...rest] = allPosts;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const postUrl = (entry: typeof featured) =>
  `/blog/${entry.data.customSlug || entry.slug}`;
---

<Base title="Blog" description="I think, therefore I scribble.">
  <div class="px-margin-mobile md:px-gutter max-w-container-max mx-auto py-16 md:py-24 pb-24">

    <div class="mb-12">
      <h1 class="font-display text-[48px] md:text-[64px] uppercase leading-none mb-4" data-reveal>Blog</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant italic" data-reveal data-reveal-delay="0.08">I think, therefore I scribble.</p>
    </div>

    {featured && (() => {
      const featFilter = featured.data.imageFilter || 'monochrome';
      const featImgClass = featFilter === 'none' ? '' : `blog-img-${featFilter}`;
      return (
      <a href={postUrl(featured)} class="block text-inherit mb-20 border-b border-outline-variant pb-16 hover:opacity-90 transition-opacity duration-600 ease-expo-out card-elegant" data-reveal data-reveal-delay="0.12">
        {featured.data.heroImage && (
          <div class="w-full aspect-[16/7] overflow-hidden rounded-xl mb-8 border border-outline-variant image-reveal">
            <img src={featured.data.heroImage} alt={featured.data.title} class={`w-full h-full object-cover block ${featImgClass}`} />
          </div>
        )}
        <div class="max-w-[720px]">
          <div class="flex items-center gap-4 flex-wrap mb-4">
            <time class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.08em]">{formatDate(featured.data.date)}</time>
            {featured.data.tags && featured.data.tags.length > 0 && (
              <div class="flex gap-2 flex-wrap">
                {featured.data.tags.map(tag => <span class="font-label-sm text-label-sm text-secondary bg-surface-container border border-outline-variant rounded px-2 py-0.5 uppercase tracking-[0.06em]">{tag}</span>)}
              </div>
            )}
          </div>
          <h2 class="font-yellowtail text-on-background text-[clamp(2rem,5vw,3.5rem)] leading-tight mb-4 tracking-[-0.01em]">{featured.data.title}</h2>
          {featured.data.excerpt && (
            <p class="font-yellowtail text-on-surface-variant text-[clamp(1.2rem,2vw,1.5rem)] leading-relaxed mb-6 max-w-[60ch]">{featured.data.excerpt}</p>
          )}
          <span class="font-label-md text-label-md text-secondary">Read &rarr;</span>
        </div>
      </a>
      );
    })()}

    {rest.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-8" data-reveal-stagger data-reveal-delay="0.2">
        {rest.map(post => {
          const postFilter = post.data.imageFilter || 'monochrome';
          const postImgClass = postFilter === 'none' ? '' : `blog-img-${postFilter}`;
          return (
          <a href={postUrl(post)} class="flex flex-col text-inherit border border-outline-variant rounded-xl overflow-hidden card-elegant hover:border-secondary">
            {post.data.heroImage && (
              <div class="w-full aspect-[16/9] overflow-hidden image-reveal">
                <img src={post.data.heroImage} alt={post.data.title} class={`w-full h-full object-cover block ${postImgClass}`} />
              </div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-4 flex-wrap mb-4">
                <time class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.08em]">{formatDate(post.data.date)}</time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex gap-2 flex-wrap">
                    {post.data.tags.map(tag => <span class="font-label-sm text-label-sm text-secondary bg-surface-container border border-outline-variant rounded px-2 py-0.5 uppercase tracking-[0.06em]">{tag}</span>)}
                  </div>
                )}
              </div>
              <h2 class="font-yellowtail text-on-background text-[1.35rem] leading-snug mb-3">{post.data.title}</h2>
              {post.data.excerpt && (
                <p class="font-yellowtail text-on-surface-variant text-[1.1rem] leading-relaxed mb-5 flex-1">{post.data.excerpt}</p>
              )}
              <span class="font-label-md text-label-md text-secondary">Read &rarr;</span>
            </div>
          </a>
          );
        })}
      </div>
    )}

    {allPosts.length === 0 && (
      <p class="font-body-lg text-body-lg italic text-on-surface-variant py-16 text-center">Nothing published yet. Check back soon.</p>
    )}

  </div>
</Base>
