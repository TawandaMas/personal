---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const [featured, ...rest] = allPosts;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const postUrl = (entry: typeof featured) =>
  `/blog/${entry.data.customSlug || entry.slug}`;
---

<Base title="Blog" description="Writing on building, AI, life, and everything in between.">
  <div class="px-margin-mobile md:px-gutter max-w-container-max mx-auto py-16 md:py-24 pb-24">

    <div class="mb-12">
      <h1 class="font-display text-[48px] md:text-[64px] uppercase leading-none mb-4">Blog</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant italic">Writing on building, AI, life, and everything in between.</p>
    </div>

    {featured && (
      <a href={postUrl(featured)} class="block text-inherit mb-20 border-b border-outline-variant pb-16 hover:opacity-85 transition-opacity">
        {featured.data.heroImage && (
          <div class="w-full aspect-[16/7] overflow-hidden rounded-xl mb-8 border border-outline-variant">
            <img src={featured.data.heroImage} alt={featured.data.title} class="w-full h-full object-cover block transition-transform duration-500 hover:scale-[1.02]" />
          </div>
        )}
        <div class="max-w-[720px]">
          <div class="flex items-center gap-4 flex-wrap mb-4">
            <time class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.08em]">{formatDate(featured.data.date)}</time>
            {featured.data.tags && featured.data.tags.length > 0 && (
              <div class="flex gap-2 flex-wrap">
                {featured.data.tags.map(tag => <span class="font-label-sm text-label-sm text-secondary bg-surface-container border border-outline-variant rounded px-2 py-0.5 uppercase tracking-[0.06em]">{tag}</span>)}
              </div>
            )}
          </div>
          <h2 class="font-body-lg text-body-lg italic text-on-background text-[clamp(2rem,5vw,3.5rem)] leading-tight mb-4 tracking-[-0.01em]">{featured.data.title}</h2>
          {featured.data.excerpt && (
            <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed mb-6 max-w-[60ch]">{featured.data.excerpt}</p>
          )}
          <span class="font-label-md text-label-md text-secondary">Read &rarr;</span>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-8">
        {rest.map(post => (
          <a href={postUrl(post)} class="flex flex-col text-inherit border border-outline-variant rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-[0_12px_24px_-4px_rgba(0,0,0,0.07)] hover:border-secondary transition-all">
            {post.data.heroImage && (
              <div class="w-full aspect-[16/9] overflow-hidden">
                <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover block transition-transform duration-400 hover:scale-[1.04]" />
              </div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-4 flex-wrap mb-4">
                <time class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-[0.08em]">{formatDate(post.data.date)}</time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex gap-2 flex-wrap">
                    {post.data.tags.map(tag => <span class="font-label-sm text-label-sm text-secondary bg-surface-container border border-outline-variant rounded px-2 py-0.5 uppercase tracking-[0.06em]">{tag}</span>)}
                  </div>
                )}
              </div>
              <h2 class="font-body-lg text-body-lg italic text-on-background text-[1.35rem] leading-snug mb-3">{post.data.title}</h2>
              {post.data.excerpt && (
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-5 flex-1">{post.data.excerpt}</p>
              )}
              <span class="font-label-md text-label-md text-secondary">Read &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    )}

    {allPosts.length === 0 && (
      <p class="font-body-lg text-body-lg italic text-on-surface-variant py-16 text-center">Nothing published yet. Check back soon.</p>
    )}

  </div>
</Base>
